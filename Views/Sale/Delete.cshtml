@model InventoryManagementSystem.Models.Sale

@{
    ViewData["Title"] = "Delete Sale";
}

<div class="container mt-4">

    <h2>Delete Sale</h2>

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this sale?</strong>
        <br />
        Delete karne par is sale ki quantity stock mein wapas add ho jayegi.
    </div>

    <!-- Sale Information -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Sale Information</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <strong>Sale ID</strong>
                    <p>@Model.SaleId</p>
                </div>

                <div class="col-md-4">
                    <strong>Sale Date</strong>
                    <p>
                        @Model.SaleDate.ToString("dd-MM-yyyy HH:mm")
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Total Amount</strong>
                    <p>
                        ₹@Model.TotalAmount.ToString("N2")
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- Sale Items -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Products Sold</h5>
        </div>

        <div class="card-body">

            @if (Model.SaleItems != null &&
                 Model.SaleItems.Any())
            {
                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Price</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int count = 1;
                        }

                        @foreach (var item in Model.SaleItems)
                        {
                            <tr>

                                <td>
                                    @count
                                </td>

                                <td>
                                    @(item.Product?.ProductName
                                        ?? "Unknown Product")
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    ₹@item.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    ₹@item.TotalPrice.ToString("N2")
                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4"
                                class="text-end">
                                Grand Total:
                            </th>

                            <th>
                                ₹@Model.TotalAmount.ToString("N2")
                            </th>

                        </tr>

                    </tfoot>

                </table>
            }
            else
            {
                <p class="text-muted">
                    No sale items found.
                </p>
            }

        </div>

    </div>


    <!-- Delete Form -->
    <form asp-action="Delete"
          asp-route-id="@Model.SaleId"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Delete Sale
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>