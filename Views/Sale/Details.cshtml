@model InventoryManagementSystem.ViewModels.SaleVM

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                🧾 Sale Details
            </h2>

            <p class="text-muted mb-0">
                View complete information about this sale
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Sales
        </a>

    </div>


    <!-- Sale Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                🧾 Sale Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Sale ID
                    </div>

                    <div class="fw-bold fs-5">
                        #@Model.SaleId
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Sale Date
                    </div>

                    <div class="fw-semibold">
                        📅 @Model.SaleDate.ToString("dd-MM-yyyy")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        Total Amount
                    </div>

                    <div class="fw-bold fs-4 text-primary">
                        ₹@Model.TotalAmount.ToString("N2")
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Sale Items -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    📦 Sale Items
                </h5>

                <span class="badge bg-primary">
                    @(Model.SaleItems?.Count ?? 0) Items
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.SaleItems != null && Model.SaleItems.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Product
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Total Price
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <span class="fw-semibold">
                                            📦 Product #@item.ProductId
                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge bg-light text-dark">
                                            @item.Quantity
                                        </span>

                                    </td>

                                    <td>
                                        ₹@item.UnitPrice.ToString("N2")
                                    </td>

                                    <td class="fw-semibold">
                                        ₹@item.TotalPrice.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="fs-1 mb-2">
                        📦
                    </div>

                    <h6>
                        No Sale Items Found
                    </h6>

                    <p class="text-muted mb-0">
                        This sale does not contain any products.
                    </p>

                </div>
            }

        </div>


        <!-- Footer -->
        <div class="card-footer bg-white py-3">

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    ← Back to List
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.SaleId"
                   class="btn btn-primary">
                    ✏️ Edit Sale
                </a>

            </div>

        </div>

    </div>

</div>