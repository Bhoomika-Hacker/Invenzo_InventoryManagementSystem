@model InventoryManagementSystem.ViewModels.SupplierVM

@{
    ViewData["Title"] = "Supplier Details";
}

<h1>Supplier Details</h1>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Supplier Name
        </dt>

        <dd class="col-sm-9">
            @Model.SupplierName
        </dd>

        <dt class="col-sm-3">
            Contact Number
        </dt>

        <dd class="col-sm-9">
            @Model.ContactNumber
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>

        <dd class="col-sm-9">
            @Model.Email
        </dd>

        <dt class="col-sm-3">
            Address
        </dt>

        <dd class="col-sm-9">
            @Model.Address
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.SupplierId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>