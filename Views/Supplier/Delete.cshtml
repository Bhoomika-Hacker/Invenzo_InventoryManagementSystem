@model InventoryManagementSystem.ViewModels.SaleVM

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container mt-4">

    <h2>Sale Details</h2>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Sale ID
        </dt>

        <dd class="col-sm-9">
            @Model.SaleId
        </dd>

        <dt class="col-sm-3">
            Sale Date
        </dt>

        <dd class="col-sm-9">
            @Model.SaleDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Total Amount
        </dt>

        <dd class="col-sm-9">
            ₹@Model.TotalAmount
        </dd>

    </dl>

    <h4 class="mt-4">Sale Items</h4>

    <table class="table table-bordered">

        <thead class="table-dark">

            <tr>
                <th>Product ID</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>

        </thead>

        <tbody>

            @if (Model.SaleItems != null && Model.SaleItems.Any())
            {
                foreach (var item in Model.SaleItems)
                {
                    <tr>

                        <td>
                            @item.ProductId
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            ₹@item.UnitPrice
                        </td>

                        <td>
                            ₹@item.TotalPrice
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No sale items found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

    <div class="mt-3">

        <a asp-action="Edit"
           asp-route-id="@Model.SaleId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>

</div>