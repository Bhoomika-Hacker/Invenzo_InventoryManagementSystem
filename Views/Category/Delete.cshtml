@model InventoryManagementSystem.ViewModels.CategoryVM

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<h3 class="text-danger">
    Are you sure you want to delete this category?
</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Category Name
        </dt>
        <dd class="col-sm-9">
            @Model.CategoryName
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="CategoryId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>