@model InventoryManagementSystem.ViewModels.CategoryVM

@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Category Name
        </dt>
        <dd class="col-sm-9">
            @Model.CategoryName
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.CategoryId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>