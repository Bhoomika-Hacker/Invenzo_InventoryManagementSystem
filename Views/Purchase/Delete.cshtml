@model InventoryManagementSystem.ViewModels.PurchaseVM

@{
    ViewData["Title"] = "Delete Purchase";
}

<h1>Delete Purchase</h1>

<h3 class="text-danger">
    Are you sure you want to delete this purchase?
</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Purchase ID
        </dt>

        <dd class="col-sm-9">
            @Model.PurchaseId
        </dd>

        <dt class="col-sm-3">
            Supplier ID
        </dt>

        <dd class="col-sm-9">
            @Model.SupplierId
        </dd>

        <dt class="col-sm-3">
            Purchase Date
        </dt>

        <dd class="col-sm-9">
            @Model.PurchaseDate.ToString("dd-MM-yyyy")
        </dd>

        <dt class="col-sm-3">
            Total Amount
        </dt>

        <dd class="col-sm-9">
            @Model.TotalAmount
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="PurchaseId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>