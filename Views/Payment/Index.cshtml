@model IEnumerable<InventoryManagementSystem.Models.Payment>
@{ViewData["Title"]="Payments";}
<div class="feature-page"><div class="feature-header"><div><div class="feature-eyebrow">FINANCE</div><h1>Payments</h1><p>Every new sale creates a pending payment; completing it changes the invoice to Paid.</p></div><a asp-controller="Billing" asp-action="Index" class="btn btn-primary">Billing</a></div>
<div class="feature-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Reference</th><th>Invoice</th><th>Method</th><th>Status</th><th>Date</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.TransactionReference</strong></td><td>@p.Billing?.InvoiceNumber</td><td>@p.Method</td><td><span class="status-pill @(p.Status=="Paid"?"paid":"unpaid")">@p.Status</span></td><td>@p.PaidAt.ToString("dd MMM yyyy, hh:mm tt")</td><td class="text-end">₹@p.Amount.ToString("N2")</td></tr>}</tbody></table></div></div></div>
