@model InventoryManagementSystem.ViewModels.SaleItemVM

@{
    ViewData["Title"] = "Delete Sale Item";
}

<h1>Delete Sale Item</h1>

<h3 class="text-danger">
    Are you sure you want to delete this sale item?
</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Sale Item ID
        </dt>

        <dd class="col-sm-9">
            @Model.SaleItemId
        </dd>

        <dt class="col-sm-3">
            Sale ID
        </dt>

        <dd class="col-sm-9">
            @Model.SaleId
        </dd>

        <dt class="col-sm-3">
            Product ID
        </dt>

        <dd class="col-sm-9">
            @Model.ProductId
        </dd>

        <dt class="col-sm-3">
            Quantity
        </dt>

        <dd class="col-sm-9">
            @Model.Quantity
        </dd>

        <dt class="col-sm-3">
            Unit Price
        </dt>

        <dd class="col-sm-9">
            @Model.UnitPrice
        </dd>

        <dt class="col-sm-3">
            Total Price
        </dt>

        <dd class="col-sm-9">
            @Model.TotalPrice
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="SaleItemId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>