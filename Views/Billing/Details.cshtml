@model InventoryManagementSystem.Models.Billing
@{ ViewData["Title"]=Model.InvoiceNumber; var pending=Model.Payments?.FirstOrDefault(p=>p.Status=="Pending"); }
<div class="invoice-page"><div class="feature-header"><div><div class="feature-eyebrow">INVOICE</div><h1>@Model.InvoiceNumber</h1><p>Sale #@Model.SaleId · @Model.IssueDate.ToString("dd MMM yyyy, hh:mm tt")</p></div><button class="btn btn-outline-secondary" onclick="window.print()">Print</button></div>
@if(TempData["BillingMessage"]!=null){<div class="alert alert-success">@TempData["BillingMessage"]</div>}
<div class="invoice-shell"><div class="invoice-top"><div><span class="invoice-label">BILLED TO</span><h3>@Model.CustomerName</h3></div><div class="text-end"><span class="invoice-label">STATUS</span><div><span class="status-pill @(Model.Status=="Paid"?"paid":"unpaid")">@Model.Status</span></div></div></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th class="text-end">Total</th></tr></thead><tbody>@foreach(var i in Model.Sale?.SaleItems ?? new List<InventoryManagementSystem.Models.SaleItem>()){<tr><td>@i.Product?.ProductName</td><td>@i.Quantity</td><td>₹@i.UnitPrice.ToString("N2")</td><td class="text-end">₹@i.TotalPrice.ToString("N2")</td></tr>}</tbody></table></div>
<div class="invoice-summary"><div><span>Subtotal</span><strong>₹@Model.Subtotal.ToString("N2")</strong></div><div><span>GST (@Model.TaxRate.ToString("0.##")%)</span><strong>₹@Model.TaxAmount.ToString("N2")</strong></div><div><span>Discount</span><strong>− ₹@Model.Discount.ToString("N2")</strong></div><div class="grand"><span>Grand Total</span><strong>₹@Model.GrandTotal.ToString("N2")</strong></div></div>
@if(Model.Status!="Paid"){<div class="payment-box"><div><div class="invoice-label">PAYMENT</div><h3>₹@Model.GrandTotal.ToString("N2")</h3><p>A pending payment is created with the invoice. Select a method and complete it here.</p></div><form asp-controller="Payment" asp-action="Pay" method="post" class="d-flex gap-2 align-items-end">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.BillingId"><div><label class="form-label small">Method</label><select name="method" class="form-select"><option>UPI</option><option>Card</option><option>Net Banking</option><option>Cash</option></select></div><button class="btn btn-primary">✓ Pay & Mark Paid</button></form></div>}else{<div class="payment-success">✓ Payment completed. This invoice is Paid.</div>}
</div></div>
